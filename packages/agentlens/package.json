{
  "name": "agentrelay-sdk",
  "version": "0.2.0",
  "description": "Privacy-safe telemetry for AgentLens.",
  "keywords": ["ai", "telemetry", "observability", "llm", "agentrelay"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentrelay": "./bin/agentlens.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./register": {
      "import": "./dist/register.js",
      "require": "./dist/register.cjs",
      "types": "./dist/register.d.ts"
    }
  },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.esm.json",
    "test": "npm run build && node ./tests/telemetry-enrichment.test.mjs && node ./tests/register.test.mjs && node ./tests/cli.test.mjs && node ./tests/provider-match.test.mjs",
    "verify:local": "node ./examples/local-verify.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
