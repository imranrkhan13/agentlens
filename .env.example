# Copy this file to .env. Do not commit the resulting .env file.
POSTGRES_PASSWORD=change-this-to-a-long-random-password
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTLENS_API_KEY_PEPPER=replace-with-a-long-random-secret
AGENTLENS_INTERNAL_API_TOKEN=replace-with-a-second-long-random-secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000
AGENTLENS_WEB_PORT=8000
AUTH_EMAIL_FROM=AgentLens <security@example.com>
RESEND_API_KEY=
NEXT_PUBLIC_ONBOARDING_VIDEO=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_ISSUES_URL=
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_ID=plan_replace_me
RAZORPAY_PLAN_SCALE_ID=plan_replace_me
AGENTLENS_ENV=development
AGENTLENS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true only when the browser must send cookie credentials. AgentLens API-key auth does not require it.
AGENTLENS_CORS_ALLOW_CREDENTIALS=false
AGENTLENS_RATE_LIMIT_CAPACITY=120
AGENTLENS_RATE_LIMIT_REFILL_PER_SECOND=2
AGENTLENS_DB_POOL_SIZE=10
AGENTLENS_DB_MAX_OVERFLOW=20
AGENTLENS_PORT=8001
AGENTLENS_POSTGRES_PORT=55432
