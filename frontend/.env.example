# Copy this file to .env.local when running `npm run dev` directly.
# The development server loads database/auth/token values from the repository
# root .env. Set DATABASE_URL directly only if you use another database.
# DATABASE_URL=postgresql://agentlens:your-postgres-password@localhost:55432/agentlens
BETTER_AUTH_URL=http://localhost:3000
# Set only when another local Postgres instance owns localhost:<port>.
# AGENTLENS_DATABASE_HOST=192.168.1.33
# BETTER_AUTH_SECRET=replace-with-the-same-local-auth-secret
# AGENTLENS_API_URL=http://localhost:8001
# AGENTLENS_INTERNAL_API_TOKEN=replace-with-the-same-internal-token
# Used only by the browser-side Diagnostics screen. Do not include /v1 here.
NEXT_PUBLIC_AGENTLENS_API_URL=http://localhost:8001
# Optional founder-help links shown in the dashboard.
NEXT_PUBLIC_ONBOARDING_VIDEO=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_ISSUES_URL=
# Razorpay Subscriptions. Keep secrets server-only; never prefix them NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_ID=plan_replace_me
RAZORPAY_PLAN_SCALE_ID=plan_replace_me
