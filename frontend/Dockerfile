FROM node:20-alpine

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_ONBOARDING_VIDEO
ARG NEXT_PUBLIC_DOCS_URL
ARG NEXT_PUBLIC_SUPPORT_URL
ARG NEXT_PUBLIC_ISSUES_URL
ENV NEXT_PUBLIC_ONBOARDING_VIDEO=$NEXT_PUBLIC_ONBOARDING_VIDEO
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL
ENV NEXT_PUBLIC_SUPPORT_URL=$NEXT_PUBLIC_SUPPORT_URL
ENV NEXT_PUBLIC_ISSUES_URL=$NEXT_PUBLIC_ISSUES_URL

RUN npm run build

EXPOSE 3000

CMD ["sh", "-c", "npm run start -- -H 0.0.0.0 -p ${PORT:-3000}"]
